    "configuration": {
      "provider_config": {
        "aws": {
          "name": "aws",
          "expressions": {
            "region": {
              "constant_value": "us-west-2"
            },
            "default_tags": [
              {
                "tags": {
                  "constant_value": {
                    "psd:application": "exampleapp",
                    "psd:environment": "dev",
                    "psd:owner": "platform-team",
                    "psd:managed-by": "terraform",
                    "psd:repo": "example-repo",
                    "psd:data-classification": "internal"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "resource_changes": []
  }
}
